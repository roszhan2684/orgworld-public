# OrgWorld lab settings, read at the start of every session. Edit and save; the next session uses them.
# For a one-off manual session, variables set in the environment win, e.g.
#   FORCE=1 STOP_AT=15:00 HARD_STOP_AT=15:30 ~/orgworld-lab/bin/daily.sh

# Nightly window, local time. No run starts unless it is expected to finish by STOP_AT. Anything still running at
# HARD_STOP_AT is stopped; that run is kept, excluded from the results and re-run from the start next session.
START_TIME=01:00   # when launchd starts the session (re-run lab/setup.sh after changing it)
STOP_AT=06:30
HARD_STOP_AT=07:30

# Experiments to run, in order (paths inside the frozen code). Each session runs the first unfinished one.
# Per the pre-registration addendum, add experiments/pilot/pilot.yaml only after reviewing the feasibility results.
QUEUE="experiments/pilot/feasibility.yaml"

REQUIRE_AC_POWER=1   # skip the night when the Mac is on battery
PUSH=1               # push the notebook to GitHub after each session
NOTEBOOK_BRANCH=lab-notebook
REPO_URL=@REPO_URL@
